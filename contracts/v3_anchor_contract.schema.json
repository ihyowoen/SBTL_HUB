{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sbtl-hub.local/contracts/v3_anchor_contract.schema.json",
  "title": "SBTL V3 Anchor Route Contract",
  "description": "Canonical machine-readable definition of the exactly-one execution or V3 non-execution anchor route. Shared V3 decision metadata is required on both routes; only override-specific rationale fields are empty on execution routes.",
  "contract_version": "3.0.0",
  "type": "object",
  "x-sbtl-contract": {
    "route_cardinality": "exactly_one",
    "route_names": [
      "execution",
      "v3_non_execution"
    ],
    "applicability": [
      "format_risk",
      "ordinary_v3_with_override_metadata"
    ],
    "preservation": "byte_for_byte_across_stages",
    "allowed_execution_anchor_strengths": [
      "strong",
      "moderate"
    ],
    "allowed_non_execution_anchor_classes": [
      "policy_regulatory_anchor",
      "data_financial_anchor",
      "strategic_behavior_anchor",
      "technology_commercialization_anchor",
      "follow_up_probability_anchor"
    ],
    "shared_strict_required_fields": [
      "anchor_classes",
      "incremental_information",
      "decision_relevance",
      "baseline_expectation_changed",
      "evidence_needed_for_stage_b",
      "next_confirmation_points",
      "prior_state",
      "new_verified_fact",
      "changed_judgment",
      "uncertainty_resolved",
      "remaining_uncertainty"
    ],
    "override_only_required_fields": [
      "structural_value_override_reason",
      "why_execution_event_not_required"
    ],
    "v3_override_required_fields": [
      "structural_value_override_reason",
      "anchor_classes",
      "incremental_information",
      "decision_relevance",
      "baseline_expectation_changed",
      "evidence_needed_for_stage_b",
      "next_confirmation_points",
      "why_execution_event_not_required",
      "prior_state",
      "new_verified_fact",
      "changed_judgment",
      "uncertainty_resolved",
      "remaining_uncertainty"
    ],
    "v3_narrative_fields": [
      "structural_value_override_reason",
      "incremental_information",
      "decision_relevance",
      "baseline_expectation_changed",
      "why_execution_event_not_required",
      "prior_state",
      "new_verified_fact",
      "changed_judgment",
      "uncertainty_resolved",
      "remaining_uncertainty"
    ],
    "allowed_stage_a_evidence_statuses": [
      "not_evidence_complete_no_fetch"
    ],
    "allowed_primary_url_semantics": [
      "provided_source_candidate_not_evidence"
    ],
    "structured_evidence_target_key_pairs": [
      [
        "source_or_document_class",
        "exact_claim_or_metric"
      ],
      [
        "source_class",
        "verification_target"
      ]
    ],
    "structured_confirmation_point_key_pairs": [
      [
        "measurable_event_or_metric",
        "interpretation_effect"
      ],
      [
        "confirmation_event",
        "confirm_weaken_invalidate"
      ]
    ],
    "empty_only_fields_by_route": {
      "execution": [
        "structural_value_override_reason",
        "why_execution_event_not_required"
      ],
      "v3_non_execution": [
        "execution_anchor_type",
        "execution_anchor_strength"
      ]
    }
  },
  "$defs": {
    "empty_route_value": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "maxLength": 0},
        {"type": "array", "maxItems": 0},
        {"type": "object", "maxProperties": 0}
      ]
    },
    "evidence_target": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source_or_document_class", "exact_claim_or_metric"],
          "properties": {
            "source_or_document_class": {"type": "string", "minLength": 2, "pattern": "^\\s*\\S[\\s\\S]*\\S\\s*$"},
            "exact_claim_or_metric": {"type": "string", "minLength": 2, "pattern": "^\\s*\\S[\\s\\S]*\\S\\s*$"}
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["source_class", "verification_target"],
          "properties": {
            "source_class": {"type": "string", "minLength": 2, "pattern": "^\\s*\\S[\\s\\S]*\\S\\s*$"},
            "verification_target": {"type": "string", "minLength": 2, "pattern": "^\\s*\\S[\\s\\S]*\\S\\s*$"}
          },
          "additionalProperties": true
        },
        {"type": "string", "minLength": 4, "pattern": "^\\s*\\S[\\s\\S]{2,}\\S\\s*$"}
      ]
    },
    "confirmation_point": {
      "oneOf": [
        {
          "type": "object",
          "required": ["measurable_event_or_metric", "interpretation_effect"],
          "properties": {
            "measurable_event_or_metric": {"type": "string", "minLength": 2, "pattern": "^\\s*\\S[\\s\\S]*\\S\\s*$"},
            "interpretation_effect": {"type": "string", "minLength": 2, "pattern": "^\\s*\\S[\\s\\S]*\\S\\s*$"}
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["confirmation_event", "confirm_weaken_invalidate"],
          "properties": {
            "confirmation_event": {"type": "string", "minLength": 2, "pattern": "^\\s*\\S[\\s\\S]*\\S\\s*$"},
            "confirm_weaken_invalidate": {"type": "string", "minLength": 2, "pattern": "^\\s*\\S[\\s\\S]*\\S\\s*$"}
          },
          "additionalProperties": true
        },
        {"type": "string", "minLength": 4, "pattern": "^\\s*\\S[\\s\\S]{2,}\\S\\s*$"}
      ]
    },
    "execution_anchor_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {"const": "execution_event_anchor"},
      "minContains": 1,
      "items": {
        "enum": [
          "execution_event_anchor",
          "policy_regulatory_anchor",
          "data_financial_anchor",
          "strategic_behavior_anchor",
          "technology_commercialization_anchor",
          "follow_up_probability_anchor"
        ]
      }
    },
    "non_execution_anchor_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "policy_regulatory_anchor",
          "data_financial_anchor",
          "strategic_behavior_anchor",
          "technology_commercialization_anchor",
          "follow_up_probability_anchor"
        ]
      }
    },
    "execution_route": {
      "type": "object",
      "required": [
        "execution_anchor_type",
        "execution_anchor_strength",
        "structural_value_override_applied",
        "anchor_classes",
        "incremental_information",
        "decision_relevance",
        "baseline_expectation_changed",
        "evidence_needed_for_stage_b",
        "next_confirmation_points",
        "prior_state",
        "new_verified_fact",
        "changed_judgment",
        "uncertainty_resolved",
        "remaining_uncertainty"
      ],
      "properties": {
        "execution_anchor_type": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "execution_anchor_strength": {"enum": ["strong", "moderate"]},
        "structural_value_override_applied": {"const": false},
        "structural_value_override_reason": {"$ref": "#/$defs/empty_route_value"},
        "anchor_classes": {"$ref": "#/$defs/execution_anchor_classes"},
        "incremental_information": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "decision_relevance": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "baseline_expectation_changed": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "evidence_needed_for_stage_b": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_target"}},
        "next_confirmation_points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/confirmation_point"}},
        "why_execution_event_not_required": {"$ref": "#/$defs/empty_route_value"},
        "prior_state": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "new_verified_fact": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "changed_judgment": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "uncertainty_resolved": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "remaining_uncertainty": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"}
      }
    },
    "v3_non_execution_route": {
      "type": "object",
      "required": [
        "structural_value_override_applied",
        "structural_value_override_reason",
        "anchor_classes",
        "incremental_information",
        "decision_relevance",
        "baseline_expectation_changed",
        "evidence_needed_for_stage_b",
        "next_confirmation_points",
        "why_execution_event_not_required",
        "prior_state",
        "new_verified_fact",
        "changed_judgment",
        "uncertainty_resolved",
        "remaining_uncertainty"
      ],
      "properties": {
        "structural_value_override_applied": {"const": true},
        "structural_value_override_reason": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "anchor_classes": {"$ref": "#/$defs/non_execution_anchor_classes"},
        "incremental_information": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "decision_relevance": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "baseline_expectation_changed": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "evidence_needed_for_stage_b": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_target"}},
        "next_confirmation_points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/confirmation_point"}},
        "why_execution_event_not_required": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "prior_state": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "new_verified_fact": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "changed_judgment": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "uncertainty_resolved": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "remaining_uncertainty": {"type": "string", "minLength": 8, "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"},
        "execution_anchor_type": {"$ref": "#/$defs/empty_route_value"},
        "execution_anchor_strength": {"$ref": "#/$defs/empty_route_value"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/execution_route"},
    {"$ref": "#/$defs/v3_non_execution_route"}
  ]
}
