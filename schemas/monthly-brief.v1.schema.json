{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sbtl.local/schemas/monthly-brief.v1.schema.json",
  "title": "SBTL Official Monthly Brief Library",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "const": "monthly-brief.v1" },
    "updated_at": { "type": ["string", "null"], "format": "date" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/brief" }
    }
  },
  "$defs": {
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "product_name",
        "month",
        "revision",
        "status",
        "publication_class",
        "publication_mode",
        "published_at",
        "title",
        "executive_diagnosis",
        "what_changed",
        "source_baseline",
        "source_card_ids",
        "key_flows",
        "refs",
        "qc",
        "approval"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "product_name": { "const": "SBTL Monthly Brief" },
        "month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["published", "revised"] },
        "publication_class": { "const": "official_editorial" },
        "publication_mode": { "const": "editorial_curated" },
        "published_at": { "type": "string", "format": "date" },
        "title": { "type": "string", "minLength": 1 },
        "executive_diagnosis": { "type": "string", "minLength": 1 },
        "what_changed": { "type": "string", "minLength": 1 },
        "source_baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["main_commit_sha", "full_blob_sha", "source_month_count"],
          "properties": {
            "main_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "full_blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "source_month_count": { "type": "integer", "minimum": 0 }
          }
        },
        "source_card_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "key_flows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "summary", "card_ids"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "card_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "watch": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["n", "id", "title", "date"],
            "properties": {
              "n": { "type": "integer", "minimum": 1 },
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "format": "date" },
              "url": { "type": "string" }
            }
          }
        },
        "qc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_status", "red_team_status", "editorial_coherence_status", "language_terminology_status"],
          "properties": {
            "evidence_status": { "const": "PASS" },
            "red_team_status": { "const": "PASS" },
            "editorial_coherence_status": { "const": "PASS" },
            "language_terminology_status": { "const": "PASS" },
            "reviewed_at": { "type": "string", "format": "date" },
            "reviewer_role": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "approved_at", "reviewer_role"],
          "properties": {
            "status": { "const": "APPROVED" },
            "approved_at": { "type": "string", "format": "date" },
            "reviewer_role": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "published" } } },
          "then": { "properties": { "revision": { "const": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "revised" } } },
          "then": { "properties": { "revision": { "minimum": 2 } } }
        }
      ]
    }
  }
}
