{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sbtl.local/schemas/strategic-brief.v1.schema.json",
  "title": "SBTL Official Strategic Brief Library",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "const": "strategic-brief.v1" },
    "generated_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/brief" }
    }
  },
  "$defs": {
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "edition",
        "month",
        "revision",
        "status",
        "publication_class",
        "publication_mode",
        "published_at",
        "title",
        "executive_diagnosis",
        "source_baseline",
        "source_card_ids",
        "structural_signals",
        "refs",
        "approval"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "edition": { "type": "string", "pattern": "^VOL\\.\\d{2,}$" },
        "month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["published", "revised"] },
        "publication_class": { "const": "official_editorial" },
        "publication_mode": { "const": "manual_editorial" },
        "published_at": { "type": "string", "format": "date" },
        "title": { "type": "string", "minLength": 1 },
        "executive_diagnosis": { "type": "string", "minLength": 1 },
        "source_baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["main_commit_sha", "full_blob_sha", "source_month_count"],
          "properties": {
            "main_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "full_blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "source_month_count": { "type": "integer", "minimum": 0 }
          }
        },
        "source_card_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "structural_signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "summary", "card_ids"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "card_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "regional_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "summary", "card_ids"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "card_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "watch": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "conclusion": { "type": "string" },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["n", "id", "title", "date"],
            "properties": {
              "n": { "type": "integer", "minimum": 1 },
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "format": "date" },
              "url": { "type": "string" }
            }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "approved_at", "reviewer_role"],
          "properties": {
            "status": { "const": "APPROVED" },
            "approved_at": { "type": "string", "format": "date" },
            "reviewer_role": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
